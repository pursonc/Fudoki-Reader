{
  "manifest_version": 3,
  "name": "Fudoki Reader",
  "version": "1.1.0",
  "description": "Read Japanese webpages with inline readings, translation, vocabulary, and speech controls.",
  "icons": {
    "128": "static/logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "static/logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "offscreen",
    "tts"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["static/logo.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
